# Scene fixtures are compared byte for byte (SC-001, FR-016), so git must
# never touch their line endings: Windows checkouts would otherwise turn LF
# into CRLF, and `core.autocrlf=input` would strip the CRLF that
# non_canonical/crlf_line_endings.scene.json exists to hold.
packages/pyro_runtime/test/fixtures/** -text

# The generator's golden files and the fixture game's committed outputs are
# compared byte for byte (spec 003), and so are the fixture game's Scene and
# animation files (spec 004); git must not rewrite their line endings.
packages/pyro_generator/test/goldens/** -text
packages/pyro_generator/fixture_game/lib/pyro.* -text
packages/pyro_generator/fixture_game/assets/** -text

# The example game's committed outputs, Scenes and Manifest golden are compared
# byte for byte by the contract test (spec 005), and so are the Play client's
# daemon transcripts; git must not rewrite their line endings.
example/lib/pyro.* -text
example/assets/** -text
example/test/goldens/** -text
apps/editor/test/fixtures/daemon/** -text
